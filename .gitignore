
# Python bytecode and cache
__pycache__/
*.py[cod]
.pytest_cache/
.mypy_cache/
.ruff_cache/

# Virtual environments
.venv/
venv/
env/

# Environment variables and secrets
.env
.env.*
!.env.example

# Editor and operating system files
.vscode/
.idea/
.DS_Store
Thumbs.db

# Dataset files: keep large/raw data out of Git
data/raw/*
!data/raw/.gitkeep

# Ignore generated analysis artifacts
*.log
*.sqlite
*.db
.coverage
htmlcov/

# Build artifacts
build/
dist/
*.egg-info/
# Generated evaluation reports
evaluation/report.json